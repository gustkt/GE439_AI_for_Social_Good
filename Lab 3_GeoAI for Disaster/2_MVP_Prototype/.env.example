# ---------------------------------------------------------------------------
# GeoAI-for-Disaster / Lightning Safety MVP - ตัวอย่างไฟล์ config
# คัดลอกเป็น .env แล้วแก้ค่าตามต้องการ:  copy .env.example .env
# ---------------------------------------------------------------------------

# แหล่งข้อมูลฟ้าผ่า (ใช้หลายแหล่งพร้อมกันได้ คั่นด้วยจุลภาค)
#   blitzortung : ฟรี ไม่ต้องมี key ไม่มี quota - stream สด แต่สถานีในไทยน้อย จับได้ไม่ครบ
#                 ระบบจึงให้ขึ้น "ปลอดภัย" ได้เมื่อเรดาร์ยืนยันด้วยว่าไม่มีฝนแรง
#   xweather    : ต้องมี client_id + client_secret มี quota - ครบและแม่นกว่า
#   replay      : เล่นข้อมูลจริงที่ capture ไว้ (ตั้ง REPLAY_FILE) ใช้เดี่ยว ๆ เท่านั้น
# ค่าแนะนำ: blitzortung,xweather  (ไม่มี key ของ Xweather ก็ใช้ได้ ระบบจะใช้ Blitzortung อย่างเดียว)
LIGHTNING_SOURCE=blitzortung,xweather

# ---- Blitzortung ------------------------------------------------------------
# เซิร์ฟเวอร์ WebSocket (ถ้าตัวแรกต่อไม่ได้จะวนไปตัวถัดไป)
BLITZORTUNG_WS_HOSTS=ws1.blitzortung.org,ws7.blitzortung.org,ws8.blitzortung.org

# ---- Ingest -------------------------------------------------------------------
# เก็บเฉพาะ strike ที่ห่างจากสนามใดสนามหนึ่งไม่เกินกี่ กม.
# ต้องกว้างกว่าวง WATCH (16 กม.) มาก ๆ เพื่อให้ nowcast เห็นพายุก่อนมันเข้าใกล้
INGEST_RADIUS_KM=30

# ---- Capture / Replay --------------------------------------------------------
# CAPTURE=true -> บันทึก strike จริงที่ผ่านการกรองลง data/captures/capture_<เวลา>.jsonl
# (ทำงานกับ xweather และ blitzortung เท่านั้น ไม่ capture ตอน replay)
CAPTURE=false
# ใช้กับ LIGHTNING_SOURCE=replay: ชื่อไฟล์ใน data/captures หรือ path เต็ม
REPLAY_FILE=
# 1 = ตามเวลาจริง (แนะนำ) / มากกว่า 1 = เร็วขึ้น แต่ความเร็วพายุและนาฬิกา all-clear จะเพี้ยนตามสัดส่วน
REPLAY_SPEED=1

# ---- Xweather (เสริม เมื่อมี quota) ---------------------------------------------------
# ต้องใช้ "คู่" client_id + client_secret (API key เดี่ยวจะได้ 401 invalid_client)
# หาได้จาก https://www.xweather.com/account -> Apps/Keys
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=
# free tier: lightning มี multiplier x10 (~1,500 call/เดือน) และย้อนหลังได้แค่ 5 นาที
POLL_INTERVAL_SECONDS=60
POLL_LIMIT=1000
# รวมสนามที่ห่างกันไม่เกินกี่ กม. ให้ใช้ query เดียวกัน
CLUSTER_MERGE_KM=10
# ยิงกี่ cluster ต่อรอบ (16 สนาม = 14 cluster; 1 cluster/รอบ ~ 20,000 call/เดือน เกิน free tier มาก
# ให้ใช้ xweather เฉพาะช่วงสั้น ๆ ที่ Blitzortung ล่ม)
POLL_CLUSTERS_PER_TICK=1
# สนามที่ Xweather เฝ้า
#   all  = ทุกสนาม active ทุกรอบ (ไม่พลาดพายุ แต่กิน quota 14 กลุ่มสนาม x 60 call/ชม.)
#   2,3  = เฉพาะสนามที่เลือก (id ดูได้จาก /api/stadiums) สนามอื่นแสดงเป็น "ไม่ได้เฝ้าระวัง"
#   ว่าง = วนทีละกลุ่มต่อรอบตาม POLL_CLUSTERS_PER_TICK (ประหยัด แต่แต่ละสนามถูกเช็กทุก ~14 นาที)
# ทั้ง all และแบบเลือกสนาม จะกระจายคำขอเท่า ๆ กันตลอด POLL_INTERVAL_SECONDS ไม่ยิงพร้อมกัน
XWEATHER_STADIUM_IDS=
# เจอ quota หมด (maxhits) หรือ credential ผิด -> หยุดยิง แล้วลองใหม่ทุกกี่นาที
XWEATHER_RETRY_MINUTES=60

# ---- เรดาร์ฝน (RainViewer) -------------------------------------------------
# เรดาร์ = สัญญาณเตือนล่วงหน้า (WATCH) / ฟ้าผ่า = หลักฐานสั่งหยุด (SUSPEND, DANGER)
# free tier: งานส่วนตัว/การศึกษาเท่านั้น, ต้องให้เครดิต RainViewer, zoom สูงสุด 7,
# ภาพย้อนหลัง 2 ชม. ทุก 10 นาที, จำกัด 100 คำขอ/นาที
RADAR_ENABLED=true
# pixel >= ค่านี้ = hotspot (40 dBZ = ตัวแทนฝนฟ้าคะนองแบบ convective ที่ใช้กันทั่วไป)
RADAR_HOTSPOT_DBZ=40
RADAR_MIN_CELL_PIXELS=4
RADAR_SEARCH_KM=50
RADAR_POLL_SECONDS=300
RADAR_STALE_MINUTES=30
RADAR_NOWCAST_WINDOW_MINUTES=40
RADAR_NOWCAST_BIN_MINUTES=10

# ---- วงรัศมีความปลอดภัย (กม.) ---------------------------------------------
# 13 กม. ~ 8 ไมล์ = เกณฑ์ NCAA สำหรับสั่งหยุดการแข่งขัน
RING_DANGER_KM=10
RING_SUSPEND_KM=13
RING_WATCH_KM=16
ALL_CLEAR_MINUTES=30

# ---- Nowcast --------------------------------------------------------------
NOWCAST_WINDOW_MINUTES=20
NOWCAST_BIN_MINUTES=5
NOWCAST_MAX_ETA_MINUTES=60
NOWCAST_MIN_SPEED_KMPM=0.2
# เร็วกว่านี้ (กม./ชม.) = ข้อมูลน้อยจนประมาณผิด ไม่รายงานความเร็วและ ETA
NOWCAST_MAX_SPEED_KMPH=120

# ---- ล้างข้อมูลเก่า -------------------------------------------------------
STRIKE_RETENTION_MINUTES=60


# ---- อื่น ๆ ---------------------------------------------------------------
DB_PATH=data/lightning.db
